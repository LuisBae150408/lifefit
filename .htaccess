# Bloquea el acceso público al archivo .env (y a .env.example, por si acaso)
# desde el navegador. Solo PHP debe poder leerlo.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# No mostrar el listado de archivos si falta un index en alguna carpeta.
Options -Indexes

# Cabeceras de seguridad basicas.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
